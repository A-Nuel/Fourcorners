# ==============================================================================
# FourCorners Environment Configuration
# Network: BNB Smart Chain Testnet (Chain ID: 97)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RPC & Blockchain Configuration
# ------------------------------------------------------------------------------
# Public BSC Testnet RPC endpoints (defaults to official Binance Data Seed)
NEXT_PUBLIC_BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545/
# Alternative backup RPC: https://bsc-testnet.public.blastapi.io

# ------------------------------------------------------------------------------
# 2. Smart Contract Addresses (BSC Testnet - Chain 97)
# ------------------------------------------------------------------------------
# Deployed ERC-8183 Escrow contract address
NEXT_PUBLIC_ERC8183_CONTRACT_ADDRESS=0x8183000000000000000000000000000000000097

# Deployed TaskEvaluator (Work Verification) contract address
NEXT_PUBLIC_EVALUATOR_CONTRACT_ADDRESS=0xE9a1000000000000000000000000000000000097

# ------------------------------------------------------------------------------
# 3. Altana Network Integration (Partner Track)
# ------------------------------------------------------------------------------
# Optional Altana project key (if created via Altana Developer Portal)
# The SDK functions in self-custodial mode with BSC Keystore registration by default
ALTANA_PROJECT_KEY=

# ------------------------------------------------------------------------------
# 4. Optional Contract Deployer Key (Only needed for deploying fresh contracts)
# ------------------------------------------------------------------------------
# Private key with testnet BNB for running `node contracts/deploy.js`
DEPLOYER_PRIVATE_KEY=
